<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/profile.css" rel="stylesheet" type="text/css">
</head>
<body>

<div id="tablediv">
<table id="outputtable">
    <thead>
        <tr id="tablehead">
            <th style="border-top-left-radius: 1vmin;">Ad</th>
            <th>Soyad</th>
            <th>TC Kimlik No</th>
            <th>Öğrenci No</th>
            <th>Fakülte</th>
            <th>Bölüm</th>
            <th>Çıktı ID</th>
            <th style="border-top-right-radius: 1vmin;">Resim</th>
        </tr>
    </thead>
    <tbody >
        
            <% data.forEach(function(outputs) { %>
                <tr id="outputrows">
                    <td><%= outputs.output_name %></td>
                    <td><%= outputs.output_surname %></td>
                    <td><%= outputs.output_tckimlikno %></td>
                    <td><%= outputs.output_student_id %></td>
                    <td><%= outputs.output_faculty %></td>
                    <td><%= outputs.output_department %></td>
                    <td><%= outputs.output_id %></td>
                    <td>
                        <% if (outputs.output_image === null) { %>
                            <p>No Image</p>
                        <% } else { %>
                            <button onclick="showImage('<%= outputs.output_image %>', '<%= outputs.output_id %>')">Show Image</button>
                        <% } %>
                    </td>
                </tr>
            <% }); %>
        
    </tbody>
</table>
</div>

<div id="image-modal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background-color:rgba(0, 0, 0, 0.8); z-index:99;"></div>
    <span id="close-modal" style="display:none; position:fixed; top:2%; right:2%; font-size:5vmax; color:white; cursor:pointer; z-index:1000;" onclick="closeImage()">×</span>
    <img id="modal-image" src="" alt="" style="display:none; max-width:80%; max-height:80%; margin:auto; position:absolute; top:0; left:0; right:0; bottom:0; z-index:1000;">
</div>


<script>
    function showImage(imageSrc, id) {
        var modal = document.getElementById('image-modal');
        var modalImage = document.getElementById('modal-image');
        modalImage.src = imageSrc;
        modalImage.alt = 'Image ID ' + id;
        modal.style.display = 'block';
        modalImage.style.display = "block";
        document.getElementById("close-modal").style.display ="block";
    }
    
    function closeImage() {
        var modal = document.getElementById('image-modal');
        modal.style.display = 'none';
        document.getElementById("close-modal").style.display = "none";
        document.getElementById("modal-image").style.display = "none";
    }
</script>
</body>
</html>