<!-- views/partials/header.ejs -->
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="/css/style.css" rel="stylesheet" type="text/css">
</head>
<body>
    <header>
        <nav>
            <a href="/anasayfa" class="headerbutton" style="margin-left: 10%;">Anasayfa</a>
            <% if (loggedin) { %>
                <span><%= username %></span>
                <a href="/table" class="headerbutton" style="margin-left: 45%;">Tablo</a>
                <a href="/logout" class="headerbutton">Çıkış Yap</a>
                
            <% } else { %>
                <a href="/login" class="headerbutton" style="margin-left:50%;">Giriş</a>
            <% } %>
        </nav>
    </header>
</body>
</html>