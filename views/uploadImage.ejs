<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8">
    <%- include('sayfalar/header', { title: 'Text Detection' }) %>
    <script async src="prebuild/opencv.js" type="text/javascript"></script>
    <script src="prebuild/tesseract.js"></script>
    <script async src="prebuild/utils.js" type="text/javascript"></script>
    <script src="imageScript.js" defer></script>
    <link href="/css/textDetection.css" rel="stylesheet" type="text/css">
    
</head>
<body>


<div>
    <div class="progress-container">
        <div class="progress-bar" id="progressBar"></div>
    </div>
    <img id="imageSrc" alt="No Image" style="display:none;" />
    <div class="buttons">
        <input class="button" type="file" id="fileInput" name="file">
    </div>
    
    <div class ="buttons">
        <input class="button" type="button" onclick="reset()" value="RESET">
    </div>
    
    
    
    <canvas id="canvasOutput" style="display: none;"></canvas>
    <canvas id="canvasoutputrect" style="display: none;"></canvas>
    <canvas id="outputFace" style="display: none;"></canvas>
    <table>
        <tr>
            <td id="infotd">
                <p class="outputs" id="name">ad</p>
            </td>
            <td rowspan="6">
                <canvas id ="cropped"></canvas>
            </td>
        </tr>
        <tr>
            <td id="infotd">
                <p class="outputs" id="surname">soyad</p>
            </td>
            
        </tr>
        <tr>
            <td id="infotd">
                <p class="outputs" id="tckimlikno">tc</p>
            </td>
            
        </tr>
        <tr>
            <td id="infotd">
                <p class="outputs" id="studentno">okulno</p>
            </td>
            
        </tr>
        <tr>
            <td id="infotd">
                <p class="outputs" id="faculty">fak</p>
            </td>
            
        </tr>
        <tr>
            <td id="infotd">
                <p class="outputs" id="department">bölüm</p>
            </td>
            
        </tr>
        
    </table>
    
</div>
<p id = "detectedText"  style="font-size: 20px;">Text</p>
</body>
</html>
