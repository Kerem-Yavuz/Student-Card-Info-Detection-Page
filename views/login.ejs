<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('sayfalar/header', { title: 'Giriş' }) %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link href="/css/login.css" rel="stylesheet" type="text/css">
</head>
<body>
    <div class="login-form">
        <form action="/login/check"  id="form" method="get">
          <h1>Giriş Yap</h1>
          <div class="content">
            <% if (checkerror) { %>
              <div id="wrongpass">
                  <p id="wrongpass" style=" color: brown;">Yanlış Şifre ve/veya kullanıcı adı*</p>
              </div>
              <% checkerror = false; %> <!-- Reset checkerror after use -->
          <% } %>
            <div class="input-field">
              <input type="name" id="username" name="username" placeholder="KULLANICI ADI" autocomplete="nickname" required>
            </div>
            <div class="input-field">
              <input type="password" id="password" name="password" placeholder="ŞİFRE" autocomplete="password" required>
            </div>
            <p id="empty" style="display: none; color: brown;">Gerekli Alanları Doldularmlısınız*</p>
          </div>
          
          
        </form>
        <div class="action" style="width: 50%; margin: 0 auto;" >
            
          <button type="submit" onclick="inputCheck()">Giriş</button>
          <button class="signupbutton" onclick="signup()">Kayıt Ol</button>
        </div>
        
      </div>
    
</body>
<script>
    function entersubmit(event) { 
            if (event.key === "Enter") {
                inputCheck();
            }
        } 
    document.addEventListener("keydown", entersubmit);//when enter clicked in login page it submits form

    function inputCheck()
    {
      let pass = document.getElementById("password").value;
      let user = document.getElementById("username").value;
      if(pass === "" || user === "")
      {
        document.getElementById("empty").style.display = "block";
      }
      else{
        document.getElementById("form").submit();
      }
    } 


    function signup()
    {
        window.location.href = "/signup";
    } 
</script>
</html>