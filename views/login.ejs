<!DOCTYPE html>
<html lang="tr">
<head>
    <%- include('sayfalar/header', { title: 'Giriş' }) %>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <link href="/css/login.css" rel="stylesheet" type="text/css">
</head>
<body>
    <div class="login-form">
        <form action="/login/check" method="get">
          <h1>Giriş Yap</h1>
          <div class="content">
            <% if (checkerror) { %>
              <div id="wrongpass">
                  <p id="wrongpass" style=" color: brown;">Wrong Username and/or Password*</p>
              </div>
              <% checkerror = false; %> <!-- Reset checkerror after use -->
          <% } %>
            <div class="input-field">
              <input type="name" name="username" placeholder="KULLANICI ADI" autocomplete="nickname" required>
            </div>
            <div class="input-field">
              <input type="password" name="password" placeholder="ŞİFRE" autocomplete="password" required>
            </div>
            
          </div>
          
          <div class="action">
            
            <button type="submit">Giriş</button>
            <button class="signupbutton" onclick="signup()">Kayıt Ol</button>
          </div>
        </form>

        
      </div>
    
</body>
<script>
    if (<%= checkerror ? 'true' : 'false' %>) {
          document.getElementById("wrongpass").style.display = "block";
      }


    function signup()
    {
        window.location.href = "/signup";
    }
</script>
</html>